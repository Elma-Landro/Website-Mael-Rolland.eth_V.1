{
  "name": "grc20-pipeline-mael-rolland",
  "version": "1.0.0",
  "description": "Pipeline de conversion et publication GRC-20 — Au-delà des codes (EHESS, 2024)",
  "type": "module",
  "scripts": {
    "dry-run":    "node grc20-publish.mjs --input ./grc20-these-mael-rolland-v114.json --dry-run",
    "testnet":    "node grc20-publish.mjs --input ./grc20-these-mael-rolland-v114.json --network TESTNET",
    "mainnet":    "node grc20-publish.mjs --input ./grc20-these-mael-rolland-v114.json --network MAINNET",
    "new-space":  "node grc20-publish.mjs --input ./grc20-these-mael-rolland-v114.json --network TESTNET --create-space",
    "worker-dev": "wrangler dev graph-worker.mjs",
    "worker-deploy": "wrangler deploy"
  },
  "dependencies": {
    "@graphprotocol/grc-20": "latest",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Maël Rolland <mael-rolland.eth>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elma-Landro/Website-Mael-Rolland.eth_V.1"
  }
}
