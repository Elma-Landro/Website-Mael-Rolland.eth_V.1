      "id": "e2157aa27a83bd481000c494d7f869e8",
      "name": "InfrastructureEvent — Pivot « blockchain sans les UCN » des acteurs financiers et des médias (2015)",
      "description": {
        "type": "TEXT",
        "value": "Année charnière où acteurs financiers et grands médias dissocient la « technologie blockchain » des unités de compte natives, et où de nombreuses entreprises de l'écosystème pivotent.",
        "options": {
          "language": "fr"
        }
      },
      "types": [
        "49a98b36b4a94099a4d35ee6ca46f629"
      ],
      "attributes": {
